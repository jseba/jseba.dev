{
  "name": "resume",
  "version": "1.0.0",
  "description": "An online resume",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start": "pnpm run dev",
    "dev": "run-s clean eleventy:dev",
    "prod": "run-s clean eleventy:prod",
    "build": "cross-env ELEVENTY_ENV=production eleventy",
    "eleventy:dev": "cross-env ELEVENTY_ENV=development eleventy --serve --port 8800",
    "eleventy:prod": "cross-env ELEVENTY_ENV=production eleventy --serve --port 8800",
    "clean": "del-cli dist",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maxboeck/resume"
  },
  "author": "Max Böck",
  "license": "MIT",
  "dependencies": {
    "@11ty/eleventy": "^2.0.0",
    "@11ty/eleventy-plugin-rss": "^1.0.7",
    "@babel/core": "^7.9.0",
    "@babel/preset-env": "^7.9.5",
    "babel-loader": "^8.1.0",
    "clean-css": "^4.2.3",
    "critical": "^5.0.3",
    "cssesc": "^3.0.0",
    "del-cli": "^3.0.0",
    "focus-visible": "^5.1.0",
    "html-minifier": "^4.0.0",
    "luxon": "^2.5.2",
    "markdown-it": "^12.3.2",
    "memfs": "^3.1.2",
    "mime": "^2.4.4",
    "node": "^16.13.1",
    "npm-run-all": "^4.1.5",
    "sass": "^1.102.0",
    "svg-sprite": "^2.0.2",
    "webpack": "^4.46.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.2"
  }
}
